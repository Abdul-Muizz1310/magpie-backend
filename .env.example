# ─── Core ──────────────────────────────────────────
APP_ENV=development                    # development | staging | production
LOG_LEVEL=debug                        # debug | info | warn | error
PORT=8000

# ─── Platform token (contract v2: docs/specs/10-platform-contract-v2.md) ───
# Tokens must carry aud "magpie"; bastion's key admits iss "bastion", the frontend
# key admits iss "magpie-frontend" with role "frontend". With NO key configured,
# every route except /health, /version, /metrics and the docs answers 503
# (fail closed) — unless APP_ENV=test.
BASTION_SIGNING_KEY_PUBLIC=
# magpie-frontend's Ed25519 public key (base64 SPKI DER); its server mints the tokens it proxies.
MAGPIE_FRONTEND_SIGNING_KEY_PUBLIC=
# true lets a request WITHOUT a token through anonymous (logged); an invalid token is
# still 401. Defaults to false.
DEMO_MODE=false

# ─── Database (Neon — scrape branch) ──────────────
DATABASE_URL=postgresql+asyncpg://user:pw@ep-xyz.neon.tech/scrape?sslmode=require

# ─── Cloudflare R2 (raw HTML snapshots — PLANNED, not wired) ───────────
# Nothing in the codebase reads or writes R2 yet; the healer re-fetches live HTML
# instead. These stay here so the eventual archive needs no env churn.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=muizz-lab
R2_PREFIX=scrape/

# ─── LLM (OpenRouter — healer) ───────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=google/gemma-4-26b-a4b-it:free  # free; blank falls back to the same slug
OPENROUTER_SITE_URL=https://github.com/Abdul-Muizz1310
OPENROUTER_APP_NAME=muizz-lab-portfolio

# ─── GitHub (healer PR creation) ─────────────────
GITHUB_PAT_SCRAPE_HEALER=ghp_...      # fine-grained PAT: contents:write + pull-requests:write on magpie-backend only
GITHUB_REPO=Abdul-Muizz1310/magpie-backend
GITHUB_HEAL_LABEL=scrape:self-heal

# ─── Observability ────────────────────────────────
# Langfuse tracing of the self-heal agent (docs/specs/12-tracing.md): both keys set →
# one trace per heal; either blank → tracing is a no-op. APP_ENV is the trace
# environment (1-40 of a-z, 0-9, _ and -; checked at startup).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ─── Scraping ─────────────────────────────────────
SCRAPE_RATE_RPS=1
PLAYWRIGHT_HEADLESS=true
